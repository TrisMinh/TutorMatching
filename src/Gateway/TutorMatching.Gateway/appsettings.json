{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Tutor": "http://tutor-service:8080",
    "Scheduling": "http://scheduling-service:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": { "ClusterId": "identity", "Match": { "Path": "/api/v1/auth/{**catch-all}" } },
      "identity-users": { "ClusterId": "identity", "Match": { "Path": "/api/v1/users/{**catch-all}" } },
      "tutors": { "ClusterId": "tutor", "Match": { "Path": "/api/v1/tutors/{**catch-all}" } },
      "subjects": { "ClusterId": "tutor", "Match": { "Path": "/api/v1/subjects/{**catch-all}" } },
      "students": { "ClusterId": "student", "Match": { "Path": "/api/v1/students/{**catch-all}" } },
      "slots": { "ClusterId": "scheduling", "Match": { "Path": "/api/v1/slots/{**catch-all}" } },
      "bookings": { "ClusterId": "scheduling", "Match": { "Path": "/api/v1/bookings/{**catch-all}" } },
      "notifications": { "ClusterId": "notification", "Match": { "Path": "/api/v1/notifications/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://identity-service:8080" } } },
      "tutor": { "Destinations": { "primary": { "Address": "http://tutor-service:8080" } } },
      "student": { "Destinations": { "primary": { "Address": "http://student-service:8080" } } },
      "scheduling": { "Destinations": { "primary": { "Address": "http://scheduling-service:8080" } } },
      "notification": { "Destinations": { "primary": { "Address": "http://notification-service:8080" } } }
    }
  }
}
