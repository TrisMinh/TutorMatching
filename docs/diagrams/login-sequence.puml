@startuml login-sequence
!include _style.puml
title Login and JWT Authorization
autonumber
actor User
participant "React Web" as Web
participant "YARP Gateway" as GW
participant "Identity Service" as ID
database "IdentityDb" as DB
participant "Tutor Service" as Tutor

User -> Web : nhập email/password
Web -> GW : POST /api/v1/auth/login
GW -> ID : forward request + traceparent
ID -> DB : lookup normalized email
DB --> ID : account + password hash
ID -> ID : verify hash, issue JWT + refresh
ID -> DB : insert refresh token hash
ID --> GW : 200 token pair
GW --> Web : 200 no-store

== Request đã xác thực ==
Web -> GW : GET /api/v1/tutors\nAuthorization: Bearer JWT
GW -> GW : validate iss/aud/signature/exp
alt token hợp lệ
  GW -> Tutor : forward JWT + trace context
  Tutor -> Tutor : validate JWT + Student policy
  Tutor --> GW : 200 tutor page
  GW --> Web : 200
else token sai hoặc hết hạn
  GW --> Web : 401 Problem Details
end
@enduml

