LOCAL_ADMIN_PASSWORD=change-me-local-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
RABBITMQ_USER=tutormatching
RABBITMQ_PASSWORD=rabbit_dev


# Public URL used by password reset emails and reminder links.
FRONTEND_ORIGIN=http://localhost:3000

# Switch only this value: mailpit (local demo) or gmail (real delivery).
EMAIL_PROVIDER=mailpit
# Fill once for Gmail. Keep these in .env, never commit credentials.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# One LOCAL_ADMIN_PASSWORD for pgAdmin login and all five database connections.
# setup.cmd generates this shared password if its placeholder is unchanged.
PGADMIN_EMAIL=admin@tutormatching.com
